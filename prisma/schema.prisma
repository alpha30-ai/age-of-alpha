generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(USER)
  rank          String?   @default("مواطن")
  isBanned      Boolean   @default(false)
  savedChapterId String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  comments      Comment[]
  videoComments VideoComment[]
  communityPosts CommunityPost[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum OTPType {
  VERIFY_EMAIL
  RESET_PASSWORD
  DELETE_ACCOUNT
}

model OTPCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      OTPType
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, code])
}

model SiteTheme {
  id              String @id @default("default")
  primaryColor    String @default("#E64A19") // magma
  secondaryColor  String @default("#A9C4EB") // milky-blue
  backgroundColor String @default("#050505") // abyss
  textColor       String @default("#B0BEC5") // silver-ash
  headingColor    String @default("#FFFFFF") // white
  borderColor     String @default("rgba(255,255,255,0.1)") // standard border
  cardOpacity     Float  @default(0.8) // For glassmorphism control
  buttonOpacity   Float  @default(1.0) // For button opacity control
  
  // Epic Banner Fields
  bannerTitle       String @default("عهد ألفا")
  bannerSubtitle    String @default("ملحمة الدول المائة")
  bannerDescription String? @default("في عالمٍ تتصارع فيه مائة دولة على السيادة المطلقة، يقف ألفا — القائد الأعلى لإمارة الصدأ — في مواجهة قوى الظلام والمؤامرات التي تهدد بابتلاع مملكته.") @db.Text
  bannerImageUrl    String?
  bannerIsActive    Boolean @default(true)

  updatedAt       DateTime @updatedAt
}

model Novel {
  id          String      @id @default(cuid())
  title       String
  description String      @db.Text
  coverImage  String?
  author      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  chapters    Chapter[]
  characters  Character[]
  videos      VideoMedia[]
  communityPosts CommunityPost[]
  chatSessions   ChatSession[]
}

model Chapter {
  id          String   @id @default(cuid())
  chapterNum  Int      @unique
  title       String
  content     String   @db.Text
  authorNote  String?  @db.Text
  imageUrl    String?
  audioUrl    String?
  
  novelId     String?
  novel       Novel?   @relation(fields: [novelId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    Comment[]
  socialSettings SocialPublishSetting[]
}

model Comment {
  id          String   @id @default(cuid())
  content     String   @db.Text
  isReported  Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CommunityPost {
  id          String   @id @default(cuid())
  content     String   @db.Text
  imageUrl    String?
  isReported  Boolean  @default(false)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  novelId     String
  novel       Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VideoMedia {
  id          String   @id @default(cuid())
  title       String
  description String?
  videoUrl    String
  thumbnail   String?
  isHosted    Boolean  @default(false)
  
  novelId     String?
  novel       Novel?   @relation(fields: [novelId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  comments    VideoComment[]
  socialSettings SocialPublishSetting[]
}

model VideoComment {
  id          String     @id @default(cuid())
  content     String     @db.Text
  isReported  Boolean    @default(false)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId     String
  video       VideoMedia @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Character {
  id          String   @id @default(cuid())
  name        String
  title       String?  // e.g., القائد الأعلى
  description String   @db.Text
  imageUrl    String?
  faction     String?  // e.g., إمارة الصدأ
  alliance    String   @default("CITIZEN") // "CITIZEN" | "ALLY" | "ENEMY" | "OTHER"
  strength    Int      @default(50)
  magic       Int      @default(50)
  intelligence Int     @default(50)
  sortOrder   Int      @default(0) // For manual ordering
  
  novelId     String?
  novel       Novel?   @relation(fields: [novelId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  socialSettings SocialPublishSetting[]
}

model SocialPublishSetting {
  id              String   @id @default(cuid())
  
  targetType      String   // "CHAPTER" | "CHARACTER" | "VIDEO"
  
  chapterId       String?
  chapter         Chapter?  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  
  characterId     String?
  character       Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  
  videoId         String?
  video           VideoMedia? @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  platform        String   // "YOUTUBE" | "FACEBOOK"
  title           String
  description     String   @db.Text
  hashtags        String   @db.Text
  youtubeTags     String?  @db.Text
  thumbnailPrompt String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([targetType, chapterId, characterId, videoId, platform])
}

model SystemSettings {
  id                    String   @id @default("default")
  openAiApiKey          String?  @db.Text
  geminiApiKey          String?  @db.Text
  cloudinaryCloudName   String?
  cloudinaryApiKey      String?
  cloudinaryApiSecret   String?
  
  isMaintenanceMode     Boolean  @default(false)
  maintenanceMessage    String?  @db.Text
  
  updatedAt             DateTime @updatedAt
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String?  // Optional, if users can be guests or logged out
  novelId   String
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  messages  ChatMessage[]
}

model ChatMessage {
  id            String   @id @default(cuid())
  sessionId     String
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role          String   // 'user' | 'model'
  content       String   @db.Text
  createdAt     DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
